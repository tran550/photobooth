[Unit]
Description=Photobooth Live Preview (Root Boot)
After=graphical.target network-online.target systemd-user-sessions.service
Wants=graphical.target network-online.target

[Service]
Type=simple
User=bran
Group=bran
WorkingDirectory=/home/bran/photobooth
Environment=PYTHONUNBUFFERED=1
Environment=VINTAGE_MODE=film
Environment=CRT_OUTPUT_SIZE=640x480
Environment=HIDE_MOUSE_CURSOR=1
Environment=OVERLAY_TEXT_FILE=/home/bran/photobooth/overlay_text.txt
Environment=OVERLAY_CORNER=bottom-right
Environment=OVERLAY_FONT_SIZE=36
Environment=OVERLAY_FONT_COLOR=white
Environment="OVERLAY_FONT_NAME=VCR OSD Mono"
Environment=OVERLAY_FONT_FILE=/home/bran/photobooth/fonts/VCR_OSD_MONO_1.001.ttf
Environment=OVERLAY_BLOCKY_MODE=1
Environment=OVERLAY_GLOW_ENABLED=0
Environment=OVERLAY_REQUIRE_PIXEL_FONT=1
Environment=VINTAGE_SCALE_FLAGS=neighbor
Environment=SHOW_REC_HUD=1
Environment=PERIODIC_RESTART_SEC=0
Environment=CAPTURE_KEY_ENABLED=1
Environment=CAPTURE_COOLDOWN_SEC=1.2
Environment=CAPTURE_PAUSE_PREVIEW=1
Environment=AUTO_PRINT_ENABLED=1
Environment=PRINT_BACKEND=none
Environment=PRINT_PAPER_WIDTH_MM=58
Environment=PRINT_HEAD_DOTS=384
Environment=PRINT_DITHER=1
Environment=PRINT_ROTATE=0
Environment=PRINT_DEVICE_FILE=
Environment=PRINT_USB_VENDOR_ID=
Environment=PRINT_USB_PRODUCT_ID=
Environment=KEYBOARD_EVENT_DEVICE=
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/python3 -u /home/bran/photobooth/controller.py
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=0
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
