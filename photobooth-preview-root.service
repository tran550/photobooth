[Unit]
Description=Photobooth Live Preview (Root Boot)
After=graphical.target network-online.target systemd-user-sessions.service
Wants=graphical.target network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=bran
Group=bran
WorkingDirectory=/home/bran/photobooth
Environment=PYTHONUNBUFFERED=1
Environment=VINTAGE_MODE=vhs
Environment=CRT_OUTPUT_SIZE=640x480
Environment=OVERLAY_TEXT_FILE=/home/bran/photobooth/overlay_text.txt
Environment=OVERLAY_CORNER=bottom-right
Environment=OVERLAY_FONT_SIZE=36
Environment=OVERLAY_FONT_COLOR=white
Environment="OVERLAY_FONT_NAME=VCR OSD Mono"
Environment=OVERLAY_FONT_FILE=/home/bran/photobooth/fonts/VCR_OSD_MONO_1.001.ttf
Environment=OVERLAY_REQUIRE_PIXEL_FONT=1
Environment=SHOW_REC_HUD=1
Environment=FILTER_SWITCH_MANUAL_APPLY_ENABLED=1
Environment=CAPTURE_KEY_ENABLED=1
Environment=CAPTURE_COOLDOWN_SEC=1.2
Environment=CAPTURE_CONFIRM_ENABLED=0
Environment=CAPTURE_CONFIRM_TIMEOUT_SEC=1.6
Environment=CAPTURE_PAUSE_PREVIEW=1
Environment=CAPTURE_FALLBACK_STOP_PREVIEW=1
Environment=CAPTURE_SAVE_ENABLED=1
Environment=CAPTURE_SAVE_DIR=/home/bran/photobooth/captures
Environment=CAPTURE_SAVE_FORMAT=png
Environment=AUTO_PRINT_ENABLED=0
Environment=PRINT_BACKEND=none
Environment=KEYBOARD_EVENT_DEVICE=/dev/input/event1
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=/usr/bin/bash -lc 'for i in {1..20}; do WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/wlr-randr --output HDMI-A-1 --mode 640x480@60.048 && exit 0; sleep 0.5; done; exit 0'
ExecStart=/usr/bin/python3 -u /home/bran/photobooth/controller.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
